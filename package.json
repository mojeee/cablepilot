{
  "name": "cablepilot",
  "productName": "CablePilot",
  "version": "0.1.0",
  "description": "Open-source electrical design for machines, control panels and electronics: multi-page schematics, live reports, cabinet layout and production drawing sets. Local, no account, your files stay yours.",
  "private": true,
  "license": "Apache-2.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "prebuild": "node scripts/check-licenses.mjs --write",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "screenshots": "node scripts/e2e.mjs --screenshots",
    "record:demo": "node scripts/e2e.mjs --demo && node scripts/demo-video.mjs && node scripts/build-site.mjs",
    "record:clips": "node scripts/e2e.mjs --clips && node scripts/clips-video.mjs && node scripts/build-site.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:library": "node scripts/check-library.mjs",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs",
    "dist": "electron-vite build && electron-builder --publish never",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-three/fiber": "^9.8.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "author": {
    "name": "Mojtaba Amini",
    "url": "https://github.com/mojeee"
  },
  "homepage": "https://cablepilot.agentflowbind.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/mojeee/cablepilot.git"
  },
  "bugs": {
    "url": "https://github.com/mojeee/cablepilot/issues"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "build": {
    "appId": "com.agentflowbind.cablepilot",
    "productName": "CablePilot",
    "copyright": "Copyright Mojtaba Amini. Apache-2.0.",
    "files": [
      "out/**/*",
      "samples/**/*",
      "!out/e2e-*/**",
      "!out/clips/**",
      "!out/demo-video/**",
      "!out/ci-linux/**",
      "!out/dev-profile/**"
    ],
    "npmRebuild": false,
    "publish": null,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "CablePilot-mac-${arch}.${ext}",
      "identity": null
    },
    "dmg": {
      "title": "CablePilot ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CablePilot-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CablePilot"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Engineering",
      "artifactName": "CablePilot-linux-${arch}.${ext}",
      "synopsis": "Electrical design for machines and control panels"
    }
  }
}
