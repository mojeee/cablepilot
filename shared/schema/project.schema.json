{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cablepilot.agentflowbind.com/schema/project.schema.json",
  "title": "CablePilot project, file format version 5",
  "description": "A CablePilot project file (.cablepilot.json). Lengths are millimetres on the page; the origin is the top-left corner of the sheet, y down. Written with a stable key order so it diffs well in Git.",
  "type": "object",
  "required": ["format", "version", "id", "name", "settings", "properties", "assembly", "templates", "potentials", "pages", "assets", "symbols", "devices", "parts", "projectParts", "wireClasses", "wireTypes", "cables", "issueStatus", "revisions"],
  "properties": {
    "format": { "const": "cablepilot-project" },
    "version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "settings": {
      "type": "object",
      "required": ["drawingLanguage", "symbolStandard", "style", "defaultSize", "defaultTemplateId", "crossRef", "bom", "numbering", "wireColours", "installationMethod", "supply", "plc"],
      "properties": {
        "drawingLanguage": { "enum": ["en", "it"] },
        "symbolStandard": { "enum": ["iec", "nfpa"] },
        "defaultSize": { "$ref": "#/$defs/size" },
        "defaultTemplateId": { "type": "string" },
        "plc": { "type": "object", "description": "PLC addressing scheme: address style and the first byte of each area", "required": ["style", "start"], "properties": { "style": { "enum": ["siemens", "iec"] }, "start": { "type": "object", "required": ["di", "do", "ai", "ao"], "properties": { "di": { "type": "integer", "minimum": 0 }, "do": { "type": "integer", "minimum": 0 }, "ai": { "type": "integer", "minimum": 0 }, "ao": { "type": "integer", "minimum": 0 } } } } }, "supply": { "type": "object", "description": "Supply data for sizing: line voltage (V), prospective short-circuit current (kA, 0 = not stated), ambient temperature (degrees C), grouped circuits, largest voltage drop (%)", "required": ["voltage", "ik", "ambient", "grouping", "maxDropPct"], "properties": { "voltage": { "type": "number", "exclusiveMinimum": 0 }, "ik": { "type": "number", "minimum": 0 }, "ambient": { "type": "number" }, "grouping": { "type": "integer", "minimum": 1 }, "maxDropPct": { "type": "number", "exclusiveMinimum": 0 } } }, "wireColours": { "type": "boolean" }, "installationMethod": { "type": "string", "description": "IEC 60364-5-52 installation method letter stated for the conductors (B2, C, E...); empty: not stated" }, "numbering": { "type": "object", "required": ["scheme", "pattern", "start", "step"], "properties": { "scheme": { "enum": ["potential", "page-column", "sequential"] }, "pattern": { "type": "string" }, "start": { "type": "integer", "minimum": 0 }, "step": { "type": "integer", "minimum": 1 } } }, "crossRef": { "type": "object", "required": ["format", "pageDigits"], "properties": { "format": { "enum": ["page.column", "page-column-row"] }, "pageDigits": { "type": "integer", "minimum": 0 } } },
        "bom": { "type": "object", "required": ["columns", "units", "group", "userFields"], "properties": { "columns": { "type": "array", "items": { "type": "string" } }, "units": { "type": "number", "minimum": 1 }, "group": { "enum": ["device", "part"] }, "userFields": { "type": "array", "items": { "type": "object", "required": ["id", "label"], "properties": { "id": { "type": "string" }, "label": { "$ref": "#/$defs/ltext" } } } } } },
        "style": {
          "type": "object",
          "required": ["colours", "weights", "font", "textSizes"],
          "properties": {
            "colours": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } },
            "weights": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } },
            "font": { "enum": ["sans", "serif", "mono"] },
            "textSizes": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } }
          }
        }
      }
    },
    "properties": { "type": "object", "additionalProperties": { "type": "string" } },
    "assembly": { "type": "object", "additionalProperties": { "type": "string" } },
    "templates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/template" } },
    "potentials": { "type": "array", "items": { "type": "object", "required": ["id", "label", "kind"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "kind": { "type": "string" } } } },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } },
    "assets": { "type": "object", "additionalProperties": { "type": "object", "required": ["name", "mime", "data", "w", "h"], "properties": { "name": { "type": "string" }, "mime": { "enum": ["image/png", "image/jpeg", "image/svg+xml"] }, "data": { "type": "string", "description": "Base64 of the file" }, "w": { "type": "number" }, "h": { "type": "number" } } } },
    "devices": { "type": "array", "description": "Device data beside the drawing: a device is every symbol and box with the same full designation", "items": { "type": "object", "required": ["designation", "parts", "fields"], "properties": { "designation": { "type": "string" }, "load": { "type": "object", "description": "Load data for sizing (three-phase AC): motor nameplate or load current", "required": ["kind"], "properties": { "kind": { "enum": ["motor", "load"] }, "powerKw": { "type": "number", "exclusiveMinimum": 0 }, "current": { "type": "number", "exclusiveMinimum": 0 }, "cosPhi": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "efficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }, "starter": { "enum": ["dol", "star-delta"] }, "curve": { "enum": ["B", "C", "D"] }, "length": { "type": "number", "minimum": 0 } } }, "parts": { "type": "array", "items": { "type": "object", "required": ["part", "qty"], "properties": { "part": { "type": "string" }, "qty": { "type": "number" } } } }, "fields": { "type": "object", "additionalProperties": { "type": "string" } }, "parent": { "type": "string" } } } },
    "parts": { "type": "array", "description": "Embedded copies of the library parts the project uses (same format as library/parts)", "items": { "type": "object", "required": ["id", "kind"], "properties": { "id": { "type": "string" }, "kind": { "const": "part" } } } },
    "projectParts": { "type": "array", "description": "Parts with no designation (mounting plate, wiring kit)", "items": { "type": "object", "required": ["id", "part", "qty", "fields"], "properties": { "id": { "type": "string" }, "part": { "type": "string" }, "qty": { "type": "number" }, "fields": { "type": "object", "additionalProperties": { "type": "string" } } } } },
    "wireClasses": { "type": "array", "description": "Company wire-class table: function (a potential id or signal), colour code, cross-section, type text, suffix", "items": { "type": "object", "required": ["id", "colour", "crossSection", "type", "suffix"], "properties": { "id": { "type": "string" }, "colour": { "type": "string" }, "crossSection": { "type": "string" }, "type": { "type": "string" }, "suffix": { "type": "string" } } } },
    "wireTypes": { "type": "array", "items": { "type": "object", "required": ["id", "type", "crossSection", "colour"], "properties": { "id": { "type": "string" }, "type": { "type": "string" }, "crossSection": { "type": "string" }, "colour": { "type": "string" } } } },
    "cables": { "type": "array", "items": { "type": "object", "required": ["id", "kind"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["multicore", "ribbon", "patch"] }, "part": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" }, "length": { "type": "string" }, "functionText": { "$ref": "#/$defs/ltext" } } } },
    "issueStatus": { "enum": ["proposal", "approval", "construction", "asBuilt"], "description": "Issue status of the whole set" },
    "revisions": { "type": "array", "description": "Issued revisions, oldest first, each with a snapshot (page hashes and an inventory of devices, wires and parts) taken at issue time", "items": { "type": "object", "required": ["number", "date", "description", "drawn", "checked", "approved", "status", "pages", "inventory"], "properties": { "number": { "type": "string" }, "date": { "type": "string" }, "description": { "type": "string" }, "drawn": { "type": "string" }, "checked": { "type": "string" }, "approved": { "type": "string" }, "status": { "enum": ["proposal", "approval", "construction", "asBuilt"] }, "pages": { "type": "array", "items": { "type": "object", "required": ["id", "title", "hash"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "hash": { "type": "string" } } } }, "inventory": { "type": "object", "required": ["devices", "wires", "parts"], "properties": { "devices": { "type": "object", "additionalProperties": { "type": "string" } }, "wires": { "type": "object", "additionalProperties": { "type": "string" } }, "parts": { "type": "object", "additionalProperties": { "type": "number" } } } } } } },
    "symbols": { "type": "array", "description": "Company symbols the project uses, embedded (same format as library/symbols)", "items": { "type": "object", "required": ["id", "kind", "pins", "graphics"], "properties": { "id": { "type": "string" }, "kind": { "const": "symbol" }, "pins": { "type": "array" }, "graphics": { "type": "array" } } } }
  },
  "$defs": {
    "size": { "enum": ["A4", "A3", "A2", "A1", "A0"] },
    "pt": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "ltext": { "type": "object", "properties": { "en": { "type": "string" }, "it": { "type": "string" } } },
    "template": {
      "type": "object",
      "required": ["id", "name", "frame", "titleBlock"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "marginText": { "type": "string" },
        "frame": {
          "type": "object",
          "required": ["margins", "columns", "rows"],
          "properties": {
            "margins": { "type": "object", "required": ["l", "t", "r", "b"], "additionalProperties": { "type": "number", "minimum": 0 } },
            "columns": { "type": "array", "items": { "type": "string" } },
            "rows": { "type": "array", "items": { "type": "string" } }
          }
        },
        "titleBlock": {
          "type": "object",
          "required": ["w", "h", "cells"],
          "properties": {
            "w": { "type": "number" },
            "h": { "type": "number" },
            "logoAssetId": { "type": "string" },
            "cells": { "type": "array", "items": { "type": "object", "required": ["key", "x", "y", "w", "h"], "properties": { "key": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" } } } }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "required": ["id", "type", "title", "size", "templateId", "elements"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["cover", "contents", "power", "control", "plc", "terminals", "cables", "layout", "singleLine", "data", "bom", "report"] },
        "title": { "$ref": "#/$defs/ltext" },
        "size": { "$ref": "#/$defs/size" },
        "templateId": { "type": "string" },
        "function": { "type": "string" },
        "location": { "type": "string" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "kind"],
      "oneOf": [
        { "properties": { "kind": { "const": "symbol" }, "symbolId": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "rot": { "enum": [0, 90, 180, 270] }, "mirror": { "type": "boolean" }, "designation": { "type": "string" }, "location": { "type": "string" }, "functionText": { "$ref": "#/$defs/ltext" }, "value": { "type": "string" }, "stateNote": { "$ref": "#/$defs/ltext" } }, "required": ["symbolId", "x", "y", "rot", "mirror", "designation"] },
        { "properties": { "kind": { "const": "wire" }, "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/pt" } }, "potential": { "type": "string" }, "number": { "type": "string" }, "conductors": { "type": "integer", "minimum": 1 }, "numberLocked": { "type": "boolean" }, "wireType": { "type": "string" }, "bundle": { "type": "boolean" }, "length": { "type": "string", "description": "Conductor length in metres, entered by hand" }, "cable": { "type": "string" }, "core": { "type": "string" } }, "required": ["points"] },
        { "properties": { "kind": { "const": "junction" }, "x": { "type": "number" }, "y": { "type": "number" } }, "required": ["x", "y"] },
        { "properties": { "kind": { "const": "text" }, "x": { "type": "number" }, "y": { "type": "number" }, "rot": { "type": "number" }, "text": { "type": "string" }, "size": { "type": "number" }, "align": { "enum": ["left", "center", "right"] }, "bold": { "type": "boolean" } }, "required": ["x", "y", "rot", "text", "size", "align"] },
        { "properties": { "kind": { "const": "line" }, "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/pt" } }, "dashed": { "type": "boolean" } }, "required": ["points"] },
        { "properties": { "kind": { "const": "rect" }, "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" }, "dashed": { "type": "boolean" }, "label": { "type": "string" }, "assembly": { "type": "string" } }, "required": ["x", "y", "w", "h"] },
        { "properties": { "kind": { "const": "box" }, "variant": { "enum": ["blackbox", "connector"] }, "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" }, "designation": { "type": "string" }, "location": { "type": "string" }, "functionText": { "$ref": "#/$defs/ltext" }, "gender": { "enum": ["plug", "socket"] }, "mate": { "type": "string" }, "pins": { "type": "array", "items": { "type": "object", "required": ["id", "side", "offset"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "side": { "enum": ["left", "right", "top", "bottom"] }, "offset": { "type": "number" }, "address": { "type": "string", "description": "PLC channel address" }, "tag": { "type": "string", "description": "PLC tag (symbol name)" }, "comment": { "type": "string" } } } }, "plc": { "type": "object", "description": "A PLC CPU or I/O card: the pins are its channels", "required": ["type", "rack", "slot"], "properties": { "type": { "enum": ["cpu", "di", "do", "ai", "ao"] }, "rack": { "type": "string" }, "slot": { "type": "number" } } } }, "required": ["variant", "x", "y", "w", "h", "designation", "pins"] },
        { "properties": { "kind": { "const": "table" }, "x": { "type": "number" }, "y": { "type": "number" }, "colWidths": { "type": "array", "items": { "type": "number" } }, "rowHeight": { "type": "number" }, "cells": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }, "size": { "type": "number" }, "headerRow": { "type": "boolean" } }, "required": ["x", "y", "colWidths", "rowHeight", "cells", "size"] },
        { "properties": { "kind": { "const": "image" }, "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" }, "assetId": { "type": "string" } }, "required": ["x", "y", "w", "h", "assetId"] },
        { "properties": { "kind": { "const": "warning" }, "x": { "type": "number" }, "y": { "type": "number" }, "size": { "type": "number" }, "sign": { "enum": ["general", "electric", "hot", "autostart"] } }, "required": ["x", "y", "size", "sign"] },
        { "properties": { "kind": { "const": "form" }, "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "items": { "type": "array" } }, "required": ["x", "y", "w", "items"] },
        { "properties": { "kind": { "const": "report" }, "x": { "type": "number" }, "y": { "type": "number" }, "report": { "enum": ["terminals", "cables", "wires", "pins", "bom", "contents", "legend", "colours", "suffixes", "torque", "nameplates", "wireMarkers", "terminalMarkers", "plcIo"] }, "offset": { "type": "integer", "minimum": 0 }, "rows": { "type": "integer", "minimum": 0 } }, "required": ["x", "y", "report", "offset", "rows"] }
      ]
    }
  }
}
